{
  "name": "react-client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-a11y-dialog": "^7.4.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2005",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "vite",
    "type-check": "tsc",
    "type-check-build": "tsc --project tsconfig.build.json",
    "build": "pnpm type-check-build && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "lint-typed": "oxlint --type-aware",
    "lint-typed-fix": "oxlint --type-aware --fix"
  }
}
